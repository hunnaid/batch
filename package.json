{
  "name": "batch",
  "private": true,
  "type": "module",
  "overrides": {
    "bson": "7.2.0"
  },
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "^7.7.0",
    "vue": "^3.5.43"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": ">=6 <7",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit",
    "start": "bun src/main.ts",
    "dev:frontend": "bun --bun vite --config web/vite.config.ts",
    "check:frontend": "vue-tsc --noEmit -p web/tsconfig.json",
    "build:frontend": "bun --bun vite build --config web/vite.config.ts",
    "test": "bun test",
    "dev:backend": "bun --watch src/main.ts",
    "dev": "bun run --parallel dev:backend dev:frontend"
  }
}
