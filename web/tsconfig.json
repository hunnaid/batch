{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "bun", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../src/text.d.ts"
  ]
}
